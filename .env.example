# Environment variables for Your HR
#
# Copy to `.env.local` for local development:  cp .env.example .env.local
#
# NEVER commit a filled-in copy of this file. `.env*` is git-ignored except this example file.
# Secrets belong in the environment only — never in source, docs, logs, or commits.

# PostgreSQL connection string (Neon in deployed environments).
# Server-only. Never expose through a NEXT_PUBLIC_* variable.
# Local development: a Neon development branch, or any PostgreSQL instance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Unpooled connection string, only if the chosen migration workflow requires it.
# Leave unset when not needed.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Public absolute origin of the deployed application.
# Optional — set it only when application behaviour genuinely needs an absolute URL
# (for example, generating absolute links in exported files or notifications).
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
